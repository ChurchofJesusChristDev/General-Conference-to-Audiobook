# Parent folder for the show library. The show name is appended.
export GENERAL_CONFERENCE_SHOW_NAME='General Conference'
export GENERAL_CONFERENCE_SHOWS_PATH='~/Videos/'

# Parent folder for the optional podcast library. The podcast name is appended.
export GENERAL_CONFERENCE_PODCAST_NAME='General Conference'
export GENERAL_CONFERENCE_PODCASTS_PATH='~/Podcasts/'

# Preferred representations. The downloader applies fallback rules automatically.
export GENERAL_CONFERENCE_VIDEO_QUALITY='720p'
export GENERAL_CONFERENCE_AUDIO_FORMAT='m4a'

# Public Brightcove playback policy key used to discover English WebVTT captions.
export GENERAL_CONFERENCE_BRIGHTCOVE_POLICY_KEY=''
